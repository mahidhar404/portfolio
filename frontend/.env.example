# Frontend environment. Copy to frontend/.env.local for local use; set this in
# Vercel (Project -> Settings -> Environment Variables) for production.

# Where the Django API lives. Leave EMPTY for local development — Vite proxies
# /api to http://127.0.0.1:8000 so same-origin requests just work.
#
# In production set it to your Render URL, with no trailing slash, e.g.
#   VITE_API_URL=https://portfolio-api.onrender.com
VITE_API_URL=
