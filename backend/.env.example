# Backend environment. Copy to backend/.env for local use; set these in Render
# for production. Never commit the filled-in version.

# --- Required in production -------------------------------------------------

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated hostnames this app answers to.
# Render gives you something like portfolio-api.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection string from Neon (Dashboard -> Connection Details).
# Leave empty locally and Django uses SQLite, which needs no setup at all.
DATABASE_URL=

# Where the frontend is served from. The API refuses browser requests from
# anywhere else, so this must match your Vercel URL exactly (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Lets Vercel preview deployments (which get a new URL each time) reach the API.
CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$

# --- Media uploads (production only) ----------------------------------------
# Render's disk is wiped on every deploy, so anything uploaded through the admin
# must live elsewhere. Free tier at cloudinary.com -> Dashboard -> API keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional ---------------------------------------------------------------

# Contact-form rate limit per IP. Raise it only for end-to-end test runs.
CONTACT_THROTTLE_RATE=5/hour

# Set to false only if you terminate TLS yourself.
SECURE_SSL_REDIRECT=true
